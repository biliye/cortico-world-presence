{
  "name": "cortico-world-presence",
  "version": "0.1.0",
  "type": "module",
  "description": "Cortico World: 在场感——前台窗口变化、离开/回来键盘、按需的窗口清单与截图",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "main": "./src/index.ts",
